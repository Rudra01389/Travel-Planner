# Server-only secrets. Never prefix these with VITE_.
MONGODB_URI=mongodb://127.0.0.1:27017/wayfare
# Optional database override; otherwise use the database in MONGODB_URI.
MONGODB_DB_NAME=
OTP_SECRET=replace-with-at-least-32-random-characters
CLIENT_ORIGIN=http://localhost:5173
PORT=5000
NODE_ENV=development
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=Wayfare
# Option A: Brevo transactional REST API (preferred)
BREVO_API_KEY=
# Option B: Brevo SMTP, used when BREVO_API_KEY is empty
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
# Set to 1 only when behind exactly one trusted reverse proxy.
TRUST_PROXY=0

# Optional live integrations. These are SERVER-ONLY; do not use VITE_ prefixes.
# Google Cloud Console -> OAuth client ID -> Web application.
# Authorized JavaScript origin: your CLIENT_ORIGIN.
# Authorized redirect URI: CLIENT_ORIGIN + /api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; normally leave blank to derive it from CLIENT_ORIGIN.
GOOGLE_REDIRECT_URI=
# Geoapify API key for real city search, nearby recommendations, and routing.
GEOAPIFY_API_KEY=
# Currency conversion uses Frankfurter daily reference rates; no key needed.
