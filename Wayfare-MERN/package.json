{
  "name": "travel-planner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/index.js",
    "start": "node server/index.js",
    "test": "node --test server/*.test.js",
    "test:smoke": "node --test server/security.test.js server/indexes.test.js server/config.test.js",
    "test:integration": "node --test server/app.test.js",
    "dev:all": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "stop:dev": "node scripts/stop-dev.js",
    "test:ui": "npm run build && node tests/browser-check.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.2.0",
    "helmet": "^8.3.0",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "mongoose": "^9.11.1",
    "nodemailer": "^10.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.6",
    "mongodb-memory-server": "^11.3.0",
    "oxlint": "^1.79.0",
    "supertest": "^7.3.1",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
